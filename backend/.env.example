# Ollama
CHAT_OLLAMA_URL=http://localhost:11434
CHAT_OLLAMA_MODEL=qwen2.5:latest
CHAT_OLLAMA_TIMEOUT_SECONDS=600

# Chat 動作
CHAT_NUM_CTX=8192
CHAT_MAX_HISTORY_CHARS=24000
CHAT_SYSTEM_PROMPT=

# プロンプトプリセットの md ファイルを置くディレクトリ
# 既定値: backend/prompts （app/config.py の _BACKEND_ROOT 配下）
# 別の場所に置きたい場合のみ設定する
# CHAT_PROMPTS_DIR=
